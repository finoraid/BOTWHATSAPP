# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_VERIFY_TOKEN=make_your_own_random_verify_token
GRAPH_API_VERSION=v23.0
# Optional: Meta App Secret for signature validation (not enabled in starter webhook yet)
META_APP_SECRET=

# Google AI Studio
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Supabase (service role key ONLY in Vercel server environment; never expose to browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Render downloader service
DOWNLOADER_URL=https://YOUR-DOWNLOADER-SERVICE.onrender.com
DOWNLOADER_SHARED_SECRET=use_the_same_long_random_secret_in_render
